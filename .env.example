# Alpaca PAPER credentials only. Never commit the real values.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Change both values before starting the app.
DASHBOARD_PASSWORD=replace-with-a-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional Discord channel webhook for fills, stops, and failures.
DISCORD_WEBHOOK_URL=

# Local server settings. Use 0.0.0.0 to view it from a phone on the same Wi-Fi.
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=data/trading_bot.db

